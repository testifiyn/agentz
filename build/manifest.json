{
  "manifest_version": 3,
  "name": "TrueGrade — Amazon Review Trust Checker",
  "short_name": "TrueGrade",
  "version": "0.1.0",
  "description": "Free, open-source, local-only trust grade for Amazon product reviews. No account, no server, no tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.amazon.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["src/selectors.js", "src/scorer.js", "src/ui.js", "src/content.js"],
      "css": ["styles/badge.css"],
      "run_at": "document_idle"
    }
  ]
}
